---
import Icon from "./Icon.astro";
const year = new Date().getFullYear();
const suppliedVersion = import.meta.env.PUBLIC_KAORI_WEBSITE_VERSION;
const websiteBuildVersion = suppliedVersion ? `v${suppliedVersion}` : "development";
const websiteBuildLabel = `Website build ${websiteBuildVersion}`;
---

<footer class="site-footer" id="contact">
  <div class="container footer-content">
    <div class="footer-identity">
      <a class="brand-lockup" href="/" aria-label="KAORI homepage">
        <img src="/branding/kaori-logo.svg" alt="" width="38" height="38" />
        <span>KAORI</span>
      </a>
      <p>Infrastructure operations, connected by evidence.</p>
      <span class="footer-note footer-acronym acronym-terms">
        <span><strong>Knowledge</strong></span>
        <span>Automation</span>
        <span><strong>Operations</strong></span>
        <span>Resilience</span>
        <span><strong>Intelligence</strong></span>
      </span>
      <span class="footer-note footer-attribution">An <strong>OXY7 ORBITAL</strong> project.</span>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <div>
        <strong>Explore</strong>
        <a href="#platform">Platform</a>
        <a href="#how-it-works">How it works</a>
        <a href="#integrations">Integrations</a>
        <a href="#architecture">Architecture</a>
        <a href="#experience">Product experience</a>
      </div>
      <div>
        <strong>Resources</strong>
        <a href="https://app.kaori.cloud"
          >Open Application <Icon name="arrow-up-right" size={14} /></a
        >
        <a href="https://docs.kaori.cloud/" target="_blank" rel="noopener noreferrer"
          >Documentation (in preparation) <Icon name="arrow-up-right" size={14} /></a
        >
        <a href="mailto:lethisaputri@gmail.com">Contact us <Icon name="mail" size={14} /></a>
      </div>
      <div class="footer-contact">
        <strong>Owner &amp; Contact</strong>
        <span>Lethisa Putri</span>
        <a href="mailto:lethisaputri@gmail.com" class="footer-email">
          <Icon name="mail" size={17} /> lethisaputri@gmail.com
        </a>
      </div>
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>© {year} KAORI. All rights reserved.</span>
    <span>Public introduction · Access to the operational application requires authorization</span>
    <span class="footer-build-version">{websiteBuildLabel}</span>
  </div>
</footer>
