---
import Icon from "./Icon.astro";
const year = new Date().getFullYear();
const suppliedVersion = import.meta.env.PUBLIC_KAORI_WEBSITE_VERSION;
const websiteBuildVersion = suppliedVersion ? `v${suppliedVersion}` : "development";
const websiteBuildLabel = `Website build ${websiteBuildVersion}`;
const websiteBuildSource = import.meta.env.PUBLIC_KAORI_WEBSITE_BUILD_SHA ?? "";
---

<footer class="site-footer" id="contact">
  <div class="container footer-content">
    <div class="footer-identity">
      <a class="brand-lockup" href="/" aria-label="KAORI homepage">
        <img src="/branding/kaori-logo.svg" alt="" width="38" height="38" />
        <span>KAORI</span>
      </a>
      <p>Infrastructure operations, connected by evidence.</p>
      <span class="footer-note footer-acronym acronym-terms">
        <span><strong>Knowledge</strong></span>
        <span>Automation</span>
        <span><strong>Operations</strong></span>
        <span>Resilience</span>
        <span><strong>Intelligence</strong></span>
      </span>
      <span class="footer-note footer-attribution">An <strong>OXY7 ORBITAL</strong> project.</span>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <div>
        <strong>Explore</strong>
        <a href="#platform">Platform</a>
        <a href="#how-it-works">How it works</a>
        <a href="#integrations">Integrations</a>
        <a href="#architecture">Architecture</a>
        <a href="#experience">Product experience</a>
      </div>
      <div>
        <strong>Resources</strong>
        <a href="https://app.kaori.cloud"
          >Open Application <Icon name="arrow-up-right" size={14} /></a
        >
        <a href="https://docs.kaori.cloud/" target="_blank" rel="noopener noreferrer"
          >Documentation <Icon name="arrow-up-right" size={14} /></a
        >
        <a href="https://github.com/OXY7O/kaori-website/issues"
          >Website issues <Icon name="arrow-up-right" size={14} /></a
        >
        <a href="https://github.com/OXY7O/kaori-website/security/advisories/new"
          >Report a vulnerability <Icon name="arrow-up-right" size={14} /></a
        >
        <a href="mailto:lethisaputri@gmail.com">Contact us <Icon name="mail" size={14} /></a>
      </div>
      <div class="footer-contact">
        <strong>Owner &amp; Contact</strong>
        <span>Lethisa Putri</span>
        <a href="mailto:lethisaputri@gmail.com" class="footer-email">
          <Icon name="mail" size={17} /> lethisaputri@gmail.com
        </a>
      </div>
    </nav>
  </div>
  <div class="container footer-privacy">
    <details class="footer-privacy-disclosure">
      <summary>Analytics privacy</summary>
      <div class="footer-privacy-panel">
        <div class="footer-privacy-copy">
          <p>Analytics is optional and requires your consent.</p>
          <p>
            Umami measures page paths, referring sites, device and language information, and
            selected clicks. Network metadata supports session and location statistics.
          </p>
          <p>
            No query strings, fragments, custom identities, search terms or session recordings.
            Privacy signals are respected. Your choice is stored locally.
          </p>
        </div>
        <div class="footer-privacy-controls">
          <div class="footer-privacy-actions">
            <button
              class="button button-secondary"
              type="button"
              data-kaori-analytics-choice="allow"
            >
              Allow analytics
            </button>
            <button
              class="button button-secondary"
              type="button"
              data-kaori-analytics-choice="deny"
            >
              Disable analytics
            </button>
          </div>
          <p role="status" data-kaori-analytics-status></p>
        </div>
      </div>
    </details>
  </div>
  <div class="container footer-bottom">
    <span>© {year} KAORI. All rights reserved.</span>
    <span>Public introduction · Access to the operational application requires authorization</span>
    <div class="footer-release-details">
      <span
        class="footer-release-version"
        data-website-release
        data-build-version={websiteBuildVersion}
        data-build-sha={websiteBuildSource}
        aria-live="polite">Stable release not verified</span
      >
      <span class="footer-build-version">{websiteBuildLabel}</span>
    </div>
  </div>
</footer>

<script>
  import { verifiedWebsiteStable } from "../scripts/website-release-status.mjs";

  const label = document.querySelector<HTMLElement>("[data-website-release]");
  if (label) {
    const build = label.dataset.buildVersion ?? "";
    const source = label.dataset.buildSha ?? "";
    if (/^v\d+\.\d+\.\d+-rc\.[1-9]\d*$/.test(build) && /^[a-f0-9]{40}$/.test(source)) {
      const receipt = (file: string) =>
        fetch(`/.well-known/kaori-website/${file}.json`, {
          cache: "no-store",
          credentials: "same-origin",
          redirect: "error",
        }).then(async (response) => (response.ok ? response.json() : null));
      Promise.all([receipt("release"), receipt("active")])
        .then(([metadata, active]: unknown[]) => {
          const stable = verifiedWebsiteStable(metadata, active, build, source);
          if (stable) label.textContent = `Website stable ${stable}`;
        })
        .catch(() => {
          // A missing/stale/invalid host receipt never authorizes a stable label.
        });
    }
  }
</script>
