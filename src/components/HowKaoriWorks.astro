---
import Icon from "./Icon.astro";

const steps = [
  {
    number: "01",
    icon: "server",
    title: "Connect sources",
    detail: "Use inventory and signals from authoritative systems.",
    tag: "Sources",
  },
  {
    number: "02",
    icon: "network",
    title: "Build context",
    detail: "Connect assets and signals across domains.",
    tag: "Context",
  },
  {
    number: "03",
    icon: "file-text",
    title: "Preserve evidence",
    detail: "Committed evidence separates facts from assumptions.",
    tag: "Evidence",
  },
  {
    number: "04",
    icon: "shield-check",
    title: "Govern the action",
    detail: "Validate and authorize each operational action.",
    tag: "Governance",
  },
];
---

<section class="section journey-section" id="how-it-works" aria-labelledby="journey-title">
  <div class="container">
    <div class="journey-heading">
      <div>
        <p class="eyebrow">How KAORI Works</p>
        <h2 id="journey-title">
          From infrastructure signals<br /><span>to operational clarity.</span>
        </h2>
      </div>
      <blockquote class="journey-quote">
        <p class="journey-quote-main">
          From trusted sources to <strong>committed evidence</strong> and <strong
            >governed decisions</strong
          >.
        </p>
        <p class="journey-quote-support">Your existing systems remain authoritative.</p>
      </blockquote>
    </div>
    <ol class="journey-steps" aria-label="Four stages of the KAORI operating approach">
      {
        steps.map((step) => (
          <li class="journey-step">
            <div class="journey-step-top">
              <span class="journey-step-number">{step.number}</span>
              <span class="journey-step-icon" aria-hidden="true">
                <Icon name={step.icon} size={24} />
              </span>
            </div>
            <span class="journey-step-tag">{step.tag}</span>
            <h3>{step.title}</h3>
            <p>{step.detail}</p>
          </li>
        ))
      }
    </ol>
    <div class="journey-scenario">
      <div class="journey-scenario-copy">
        <p class="eyebrow">A practical example</p>
        <h3>When an alert arrives,<br /><span>the signal is only the beginning.</span></h3>
        <blockquote class="journey-quote">
          <p class="journey-quote-main">
            Signals reveal symptoms. <strong>Context and evidence</strong> shape the next decision.
          </p>
          <p class="journey-quote-support">Authorized workflows keep follow-up accountable.</p>
        </blockquote>
        <a class="text-link" href="#experience">
          Explore the product experience <Icon name="arrow-right" size={17} />
        </a>
      </div>
      <div
        class="journey-scenario-flow"
        aria-label="Illustrative example: alert signal, asset context, evidence, then controlled response"
      >
        <div><Icon name="activity" size={20} /><span>Monitoring signal</span></div>
        <span class="journey-flow-arrow" aria-hidden="true">↓</span>
        <div><Icon name="layers" size={20} /><span>Asset &amp; ownership context</span></div>
        <span class="journey-flow-arrow" aria-hidden="true">↓</span>
        <div><Icon name="file-text" size={20} /><span>Committed evidence</span></div>
        <span class="journey-flow-arrow" aria-hidden="true">↓</span>
        <div class="journey-flow-outcome">
          <Icon name="shield-check" size={20} /><span>Governed follow-up</span>
        </div>
      </div>
    </div>
    <p class="journey-scenario-note">
      Illustrative operating approach. Individual integrations and workflows depend on configured
      capabilities and permissions; no live infrastructure data is shown.
    </p>
  </div>
</section>
