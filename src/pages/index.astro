---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroVisual from "../components/HeroVisual.astro";
import IntegrationCatalog from "../components/IntegrationCatalog.astro";
import HowKaoriWorks from "../components/HowKaoriWorks.astro";
import Icon from "../components/Icon.astro";

const values = [
  {
    icon: "database",
    title: "Evidence-driven",
    body: "Turn committed evidence into reliable context.",
  },
  {
    icon: "layers",
    title: "Source authority",
    body: "Existing systems remain the source of truth.",
  },
  {
    icon: "network",
    title: "Unified operations",
    body: "Connect context across domains and workflows.",
  },
  {
    icon: "shield-check",
    title: "Governed by design",
    body: "Make operational decisions accountable.",
  },
];

const capabilities = [
  {
    icon: "eye",
    title: "Infrastructure visibility",
    body: "Understand assets, inventory, relationships, and the scope of your operations.",
    tag: "Observe",
  },
  {
    icon: "sliders-horizontal",
    title: "Operational workflows",
    body: "Coordinate selected tasks with explicit authorization, validation, and evidence.",
    tag: "Act",
  },
  {
    icon: "chart-no-axes-column",
    title: "Analytics & intelligence",
    body: "Connect historical context and operational signals to support better decisions.",
    tag: "Interpret",
  },
  {
    icon: "shield-check",
    title: "Governance & audit",
    body: "Keep permissions, change history, and operational responsibility visible.",
    tag: "Assure",
  },
];

const technologies = [
  {
    name: "Kubernetes",
    icon: "box",
    category: "Compute and workload orchestration",
    domain: "Runtime",
  },
  {
    name: "S3-compatible",
    icon: "database",
    category: "Object storage systems",
    domain: "Storage",
  },
  {
    name: "Prometheus",
    icon: "activity",
    category: "Metric signals and monitoring",
    domain: "Observability",
  },
  {
    name: "Alertmanager",
    icon: "bell-ring",
    category: "Alert routing context",
    domain: "Observability",
  },
  {
    name: "GitHub",
    icon: "git-branch",
    category: "Source-controlled definitions",
    domain: "Source Control",
  },
  { name: "Harbor", icon: "layers", category: "Container artifact registry", domain: "Registry" },
];
const summary =
  "KAORI provides unified infrastructure visibility, operational workflows, analytics, reporting, and governance while keeping integrated infrastructure systems authoritative.";
---

<BaseLayout title="KAORI — Operate with Clarity" description={summary}>
  <section class="hero-section">
    <div class="hero-atmosphere" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> Infrastructure Operations Platform</p>
        <h1>Meet KAORI.<br /><span>Operate with Clarity.</span></h1>
        <p class="hero-description">
          <span class="copy-line"
            >KAORI connects infrastructure context and committed evidence.</span
          >
          <span class="copy-line">It governs workflows while your systems stay authoritative.</span>
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="https://app.kaori.cloud"
            >Open Application <Icon name="arrow-up-right" size={18} /></a
          >
          <a class="button button-secondary" href="#how-it-works"
            >How KAORI Works <Icon name="arrow-right" size={17} /></a
          >
        </div>
        <p class="hero-micro">
          <span class="micro-indicator"></span> Knowledge · Automation · Operations · Resilience · Intelligence
        </p>
      </div>
      <HeroVisual />
    </div>
  </section>

  <section class="value-section" aria-label="KAORI operating principles">
    <div class="container value-grid">
      {
        values.map((value) => (
          <div class="value-item">
            <div class="value-icon">
              <Icon name={value.icon} size={22} />
            </div>
            <div>
              <>
                <h2>{value.title}</h2>
                <p>{value.body}</p>
              </>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section platform-section" id="platform">
    <div class="container feature-intro">
      <div class="section-intro">
        <p class="eyebrow">Built for real infrastructure</p>
        <h2>Operate with context.<br /><span>Not isolated tools.</span></h2>
        <p>
          Connect infrastructure inventory, workflows, analytics, reporting, and governance without
          replacing your existing tools or their source authority.
        </p>
        <a class="text-link" href="#architecture"
          >See the architecture <Icon name="arrow-right" size={17} /></a
        >
      </div>
      <div class="capability-grid">
        {
          capabilities.map((feature) => (
            <article class="capability-card">
              <div class="capability-top">
                <>
                  <span class="capability-icon">
                    <Icon name={feature.icon} size={25} />
                  </span>
                  <span class="capability-tag">{feature.tag}</span>
                </>
              </div>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
              <div class="capability-art" aria-hidden="true">
                <div class="capability-art-orbit">
                  <span class="capability-art-node capability-art-node-one">
                    <Icon name="database" size={18} />
                  </span>
                  <span class="capability-art-core">
                    <Icon name={feature.icon} size={34} />
                  </span>
                  <span class="capability-art-node capability-art-node-two">
                    <Icon name="network" size={18} />
                  </span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <HowKaoriWorks />

  <section class="section integrations-section" id="integrations">
    <div class="container">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">Technology ecosystem</p>
          <h2>Keep the tools you trust.<br /><span>Connect the context.</span></h2>
          <p>
            External systems remain authoritative. KAORI provides normalization, correlation,
            committed evidence, and governance across integrations.
          </p>
        </div>
        <div class="ecosystem-principle" aria-label="KAORI integration design principle">
          <span class="ecosystem-principle-icon" aria-hidden="true">
            <Icon name="network" size={24} />
          </span>
          <div>
            <span class="ecosystem-principle-label">BUILT AROUND YOUR OPERATIONS</span>
            <strong>Capabilities lead. Tools connect.</strong>
            <p>KAORI adds shared context while your trusted systems stay authoritative.</p>
          </div>
        </div>
      </div>
      <IntegrationCatalog integrations={technologies} />
    </div>
  </section>

  <section class="section architecture-section" id="architecture">
    <div class="container architecture-layout">
      <div class="section-intro">
        <p class="eyebrow">Platform architecture</p>
        <h2>Normalize. Orchestrate.<br /><span>Correlate. Govern.</span></h2>
        <p>
          <span class="copy-line">KAORI links context, governed workflows, and evidence.</span>
          <span class="copy-line">External systems remain authoritative.</span>
        </p>
        <a class="text-link" href="#experience"
          >See the product experience <Icon name="arrow-right" size={17} /></a
        >
      </div>
      <div
        class="architecture-diagram"
        aria-label="External authorities provide source context; KAORI normalizes, correlates, orchestrates, commits evidence and governs workflows to provide operational clarity"
      >
        <div class="diagram-column source">
          <span class="diagram-eyebrow">External authority</span>
          <Icon name="server" size={27} />
          <strong>External systems</strong>
          <span>Compute · Storage · Observability · Source control</span>
          <span>External sources remain authoritative</span>
        </div>
        <span class="diagram-arrow" aria-hidden="true">→</span>
        <div class="diagram-column center">
          <img src="/branding/kaori-logo.svg" alt="" width="38" height="38" />
          <strong>KAORI</strong>
          <span>Normalize context</span>
          <span>Orchestrate workflows</span>
          <span>Correlate signals</span>
          <span>Commit evidence</span>
          <span>Govern operations</span>
        </div>
        <span class="diagram-arrow" aria-hidden="true">→</span>
        <div class="diagram-column consumer">
          <span class="diagram-eyebrow">Operational context</span>
          <Icon name="network" size={27} />
          <strong>Operational clarity</strong>
          <span>Shared visibility · Intelligence · Accountability</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section experience-section" id="experience">
    <div class="container experience-layout">
      <div class="section-intro">
        <p class="eyebrow">Product experience</p>
        <h2>See KAORI<br /><span>in action.</span></h2>
        <p>
          <span class="copy-line">See KAORI connect context and committed evidence.</span>
          <span class="copy-line">Explore governed workflows in a conceptual workspace.</span>
        </p>
        <a
          class="button button-primary"
          href="https://app.kaori.cloud"
          rel="noopener noreferrer"
          target="_blank">Open KAORI Application <Icon name="arrow-up-right" size={17} /></a
        >
        <p class="small-note">
          Application access is subject to existing authentication and permissions.
        </p>
      </div>
      <div
        class="product-preview"
        aria-label="Illustrative interface layout of the KAORI infrastructure workspace"
      >
        <div class="preview-sidebar">
          <div class="preview-logo">
            <img src="/branding/kaori-logo.svg" alt="" width="22" height="22" /><strong
              >KAORI</strong
            >
          </div>
          <div class="preview-menu-active"><Icon name="layers" size={15} /> Overview</div>
          <div><Icon name="database" size={15} /> Inventory</div>
          <div><Icon name="workflow" size={15} /> Operations</div>
          <div><Icon name="shield" size={15} /> Governance</div>
        </div>
        <div class="preview-main">
          <div class="preview-topbar">
            <span class="preview-search"></span><span class="preview-avatar"></span>
          </div>
          <p class="preview-kicker">INFRASTRUCTURE OPERATIONS</p>
          <h3>Connected operations</h3>
          <p class="preview-description">Context, committed evidence, and governed workflows</p>
          <div class="preview-stat-grid">
            <div>
              <Icon name="database" size={21} /><strong>Inventory</strong><span
                >Committed context</span
              >
            </div>
            <div>
              <Icon name="network" size={21} /><strong>Relationships</strong><span
                >Cross-domain links</span
              >
            </div>
            <div>
              <Icon name="shield" size={21} /><strong>Governance</strong><span
                >Controlled activity</span
              >
            </div>
          </div>
          <div class="preview-flow">
            <div class="flow-node"><span></span><strong>Source systems</strong></div>
            <div class="flow-connector"></div>
            <div class="flow-node active"><span></span><strong>Committed evidence</strong></div>
            <div class="flow-connector"></div>
            <div class="flow-node"><span></span><strong>Operational insight</strong></div>
          </div>
        </div>
        <div class="preview-watermark">UI CONCEPT · NOT LIVE OPERATIONAL DATA</div>
      </div>
    </div>
  </section>

  <section class="closing-section">
    <div class="container closing-inner">
      <div>
        <p class="eyebrow">Explore KAORI</p><h2>
          Discover how<br /><span>KAORI works.</span>
        </h2>
        <p class="closing-description">
          Explore how infrastructure sources become shared context, committed evidence, and governed
          action.
        </p>
      </div>
      <div class="closing-actions">
        <a class="button button-primary" href="https://app.kaori.cloud"
          >Open Application <Icon name="arrow-up-right" size={18} /></a
        >
        <a class="button button-outline-light" href="#how-it-works"
          >How KAORI Works <Icon name="arrow-right" size={17} /></a
        >
      </div>
    </div>
  </section>
</BaseLayout>
