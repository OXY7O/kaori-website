---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="KAORI unifies infrastructure visibility, operational workflows, analytics, reporting, and governance."
    />
    <title>KAORI — Infrastructure Operations Platform</title>
  </head>
  <body>
    <main
      class="mx-auto flex min-h-screen max-w-5xl flex-col items-center justify-center gap-6 px-6 text-center"
    >
      <img src="/branding/kaori-logo.svg" alt="KAORI" width="88" height="88" />
      <p class="text-sm font-semibold tracking-[.2em] text-brand-primary uppercase">
        KAORI Website Foundation
      </p>
      <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">
        From infrastructure to <span class="text-brand-primary">insight.</span>
      </h1>
      <p class="max-w-xl text-base leading-relaxed text-slate-600">
        A unified infrastructure operations platform built on committed evidence, cross-domain
        context, and provider authority.
      </p>
      <p class="text-sm text-slate-500">The approved editorial Home Page is tracked in issue #3.</p>
    </main>
  </body>
</html>
